<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tiktok_publish_wizard_form" model="ir.ui.view">
        <field name="name">tiktok.publish.wizard.form</field>
        <field name="model">tiktok.publish.wizard</field>
        <field name="arch" type="xml">
            <form string="Đăng video TikTok Inbox">
                <group>
                    <field name="tiktok_account_id" readonly="1"/>
                    <field name="video_id"
                             options="{'no_create': True}"
                             placeholder="Chọn video trên R2"/>
                    <field name="caption"
                             placeholder="Gợi ý caption (optional)"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Apply sẽ kéo video về temp rồi upload TikTok Inbox
                    (<code>FILE_UPLOAD</code>). Sau đó mở app → Inbox → Edit → Post.
                </div>
                <footer>
                    <button name="action_apply" type="object" string="Apply"
                            class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
