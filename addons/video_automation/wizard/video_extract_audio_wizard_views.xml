<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_video_extract_audio_wizard_form" model="ir.ui.view">
        <field name="name">video.extract.audio.wizard.form</field>
        <field name="model">video.extract.audio.wizard</field>
        <field name="arch" type="xml">
            <form string="Extract Audio">
                <group>
                    <field name="video_id" readonly="1"/>
                    <field name="storage_id"/>
                    <field name="name" placeholder="Nhập tên audio..."/>
                </group>
                <footer>
                    <button name="action_extract" type="object" string="Tách audio"
                            class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
