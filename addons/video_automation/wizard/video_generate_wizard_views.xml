<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_video_generate_wizard_form" model="ir.ui.view">
        <field name="name">video.generate.wizard.form</field>
        <field name="model">video.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Tạo Video TikTok">
                <group>
                    <group string="Nguồn Đầu Vào">
                        <field name="image_id" readonly="1" invisible="not image_id"/>
                        <field name="video_id" readonly="1" invisible="not video_id"/>
                        <field name="audio_id" options="{'no_create': True}"
                               placeholder="Để trống = tự động chọn nhạc ít dùng"/>
                        <field name="output_name" placeholder="Tên video thành phẩm (tùy chọn)"/>
                    </group>
                    <group string="Cấu Hình Hiệu Ứng &amp; Text" invisible="not image_id">
                        <field name="effect_preset"/>
                        <field name="hook_text" placeholder="VD: Mẫu này đang cực hot 🔥"/>
                        <field name="cta_text" placeholder="VD: Xem sản phẩm bên dưới ↓"/>
                    </group>
                    <group string="Logo (Tùy chọn)" invisible="image_id">
                        <field name="logo_filename" invisible="1"/>
                        <field name="logo_file" filename="logo_filename"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    Tạo <b>video mới chuẩn 9:16</b> (1080x1920, 30 FPS). Tự động tạo record trong Thư viện Video và không ghi đè dữ liệu gốc.
                </div>
                <footer>
                    <button name="action_generate" type="object" string="Bắt Đầu Tạo Video"
                            class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

