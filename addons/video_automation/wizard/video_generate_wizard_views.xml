<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_video_generate_wizard_form" model="ir.ui.view">
        <field name="name">video.generate.wizard.form</field>
        <field name="model">video.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Gen Video">
                <group>
                    <field name="video_id" readonly="1"/>
                    <field name="audio_id" options="{'no_create': False}"
                            placeholder="Để trống = auto chọn nhạc"/>
                    <div class="text-muted" colspan="2">
                        Không chọn nhạc → hệ thống tự chọn ngẫu nhiên 1 audio trong Audio Library.
                    </div>
                    <field name="output_name" placeholder="Tên file output (optional)"/>
                    <field name="logo_filename" invisible="1"/>
                    <field name="logo_file" filename="logo_filename"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate"
                            class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
