<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_music_video_generate_wizard_form" model="ir.ui.view">
        <field name="name">music.video.generate.wizard.form</field>
        <field name="model">music.video.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Tạo Video Ca Nhạc (Music Video Generator)">
                <group>
                    <group string="Hình Ảnh &amp; Âm Nhạc">
                        <field name="name" placeholder="VD: MV - Chill Night (Lofi)"/>
                        <field name="bg_image_id" options="{'no_create': True}"/>
                        <field name="character_image_id" options="{'no_create': True}"/>
                        <field name="audio_id" options="{'no_create': True}"
                               placeholder="Để trống = tự động chọn bài ít dùng nhất"/>
                        <field name="storage_id" options="{'no_create': True}"/>
                        <field name="max_duration"/>
                    </group>
                    <group string="Bố Cục &amp; Hiệu Ứng Sóng Nhạc">
                        <field name="music_preset"/>
                        <field name="music_layout"/>
                        <field name="visualizer_style"/>
                        <field name="visualizer_color"/>
                        <field name="particle_effect"/>
                        <field name="effect_preset"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    🎵 Tự động tạo <b>Video Ca Nhạc 9:16 (1080×1920, 30 FPS)</b> chuẩn TikTok/Shorts:
                    kết hợp <b>Ảnh Background</b> + <b>Ảnh Nhân vật</b> + <b>Sóng nhạc Visualizer Realtime</b> + <b>Beat Bounce &amp; Flash</b> nhịp điệu.
                </div>
                <footer>
                    <button name="action_generate" type="object" string="🎬 Bắt Đầu Tạo Video Ca Nhạc"
                            class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_music_video_generate_wizard" model="ir.actions.act_window">
        <field name="name">Tạo Video Ca Nhạc</field>
        <field name="res_model">music.video.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
