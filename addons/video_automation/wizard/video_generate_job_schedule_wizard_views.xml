<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_video_generate_job_schedule_wizard_form" model="ir.ui.view">
        <field name="name">video.generate.job.schedule.wizard.form</field>
        <field name="model">video.generate.job.schedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Đặt Lịch Chạy Hàng Loạt (Schedule Jobs)">
                <sheet>
                    <p class="text-muted">
                        Thiết lập thời gian bắt đầu và khoảng cách thời gian giãn cách giữa các job đã chọn để Cron tự động thực thi tuần tự.
                    </p>
                    <group>
                        <field name="start_date"/>
                        <field name="interval_minutes"/>
                        <field name="set_priority"/>
                        <field name="priority" invisible="not set_priority"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_schedule"
                            type="object"
                            string="Áp Dụng Lịch Chạy"
                            class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_video_generate_job_schedule_wizard" model="ir.actions.act_window">
        <field name="name">Đặt Lịch Chạy Hàng Loạt</field>
        <field name="res_model">video.generate.job.schedule.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_video_generate_job"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
