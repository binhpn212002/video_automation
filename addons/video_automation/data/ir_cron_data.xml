<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_auto_create_publish_queue" model="ir.cron">
        <field name="name">VA: Auto Create Publish Queue</field>
        <field name="model_id" ref="model_tiktok_publish_queue"/>
        <field name="state">code</field>
        <field name="code">model.cron_auto_create_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_publish_tiktok" model="ir.cron">
        <field name="name">VA: Publish TikTok Due</field>
        <field name="model_id" ref="model_tiktok_publish_queue"/>
        <field name="state">code</field>
        <field name="code">model.cron_publish_due()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_retry_failed_publish" model="ir.cron">
        <field name="name">VA: Retry Failed Publish</field>
        <field name="model_id" ref="model_tiktok_publish_queue"/>
        <field name="state">code</field>
        <field name="code">model.cron_retry_failed()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_refresh_tiktok_tokens" model="ir.cron">
        <field name="name">VA: Refresh TikTok Tokens</field>
        <field name="model_id" ref="model_tiktok_account"/>
        <field name="state">code</field>
        <field name="code">model.cron_refresh_tokens()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
