<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_audio_library_tree" model="ir.ui.view">
        <field name="name">audio.library.tree</field>
        <field name="model">audio.library</field>
        <field name="arch" type="xml">
            <tree string="Thư Viện Audio">
                <header>
                    <button name="action_open_deduplicate_wizard" type="object"
                            string="Dọn Dẹp Trùng Lặp" class="btn-secondary" icon="fa-filter"/>
                </header>
                <field name="name"/>
                <field name="bpm"/>
                <field name="beat_status" widget="badge"
                       decoration-success="beat_status == 'detected'"
                       decoration-warning="beat_status == 'fallback'"
                       decoration-muted="beat_status == 'none'"/>
                <field name="duration" widget="float_time"/>
                <field name="cdn_url" widget="url"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_audio_library_form" model="ir.ui.view">
        <field name="name">audio.library.form</field>
        <field name="model">audio.library</field>
        <field name="arch" type="xml">
            <form string="Audio / Nhạc Nền">
                <header>
                    <button name="action_upload_to_r2" type="object" string="Upload lên R2"
                            class="btn-primary"
                            invisible="not upload_file"/>
                    <button name="action_analyze_beats" type="object" string="Phân Tích Beat (Nhịp)"
                            class="btn-secondary"
                            invisible="not storage_path"/>
                </header>
                <sheet>
                    <group string="Tải file từ thiết bị" invisible="storage_path">
                        <group>
                            <field name="upload_filename" invisible="1"/>
                            <field name="upload_file" filename="upload_filename"
                                     string="Chọn file audio"/>
                        </group>
                        <group>
                            <div class="text-muted" colspan="2">
                                Chọn file từ máy → bấm Upload lên R2. Hệ thống sẽ tự động nhận diện nhịp (beats) và lưu trữ.
                            </div>
                        </group>
                    </group>
                    <group>
                        <group string="Thông Tin Cơ Bản">
                            <field name="name"/>
                            <field name="filename" readonly="1"/>
                            <field name="storage_id"/>
                            <field name="source_video_id" readonly="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Lưu Trữ &amp; Kỹ Thuật">
                            <field name="storage_path" readonly="1"/>
                            <field name="cdn_url" widget="url" readonly="1"/>
                            <field name="duration" readonly="1"/>
                            <field name="file_size" readonly="1"/>
                        </group>
                    </group>
                    <group string="Phân Tích Beat &amp; Nhịp Điệu">
                        <group>
                            <field name="beat_status" widget="badge"
                                   decoration-success="beat_status == 'detected'"
                                   decoration-warning="beat_status == 'fallback'"
                                   decoration-muted="beat_status == 'none'"/>
                            <field name="bpm" readonly="1"/>
                        </group>
                        <group>
                            <field name="beat_data" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_audio_library" model="ir.actions.act_window">
        <field name="name">Audio Library</field>
        <field name="res_model">audio.library</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>

