<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_video_generate_job_tree" model="ir.ui.view">
        <field name="name">video.generate.job.tree</field>
        <field name="model">video.generate.job</field>
        <field name="arch" type="xml">
            <tree string="Tiến Trình Render Video"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'processing'"
                  decoration-success="state == 'completed'"
                  decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="job_type" widget="badge"
                       decoration-primary="job_type == 'music_video'"
                       decoration-info="job_type == 'affiliate'"/>
                <field name="output_video_name" optional="show"/>
                <field name="character_image_id" optional="show"/>
                <field name="bg_image_id" optional="hide"/>
                <field name="image_id" optional="hide"/>
                <field name="audio_id"/>
                <field name="duration" widget="float_time"/>
                <field name="create_date" string="Thời Gian Tạo"/>
                <field name="finish_date" string="Hoàn Thành"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'processing'"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'failed'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_video_generate_job_form" model="ir.ui.view">
        <field name="name">video.generate.job.form</field>
        <field name="model">video.generate.job</field>
        <field name="arch" type="xml">
            <form string="Chi Tiết Job Render Video">
                <header>
                    <button name="action_run_job"
                            type="object"
                            string="Thực Thi Job Ngay"
                            class="btn-primary"
                            invisible="state == 'completed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,processing,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Mã Job"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                        <h3>
                            <field name="output_video_name" placeholder="Tên video dự kiến..."/>
                        </h3>
                    </div>
                    <group>
                        <group string="Loại Video &amp; Nguồn">
                            <field name="job_type"/>
                            <field name="image_id" options="{'no_create': True}" invisible="job_type != 'affiliate'"/>
                            <field name="bg_image_id" options="{'no_create': True}" invisible="job_type != 'music_video'"/>
                            <field name="character_image_id" options="{'no_create': True}" invisible="job_type != 'music_video'"/>
                            <field name="audio_id" options="{'no_create': True}"/>
                            <field name="storage_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Bố Cục &amp; Hiệu Ứng" invisible="job_type != 'music_video'">
                            <field name="music_layout"/>
                            <field name="visualizer_style"/>
                            <field name="visualizer_color"/>
                            <field name="particle_effect"/>
                            <field name="music_preset"/>
                            <field name="effect_preset"/>
                            <field name="max_duration"/>
                        </group>
                        <group string="Cấu Hình Affiliate" invisible="job_type != 'affiliate'">
                            <field name="motion_effect"/>
                            <field name="effect_preset"/>
                            <field name="flash_effect"/>
                            <field name="hook_text"/>
                            <field name="cta_text"/>
                        </group>
                    </group>

                    <group string="Kết Quả Render" invisible="state != 'completed'">
                        <field name="video_id" readonly="1"/>
                        <field name="video_url" widget="url" readonly="1"/>
                        <field name="duration" readonly="1"/>
                        <field name="finish_date" readonly="1"/>
                    </group>

                    <div invisible="not error_message" class="alert alert-danger" role="alert">
                        <strong>Lỗi: </strong><field name="error_message" readonly="1"/>
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Main Action -->
    <record id="action_video_generate_job" model="ir.actions.act_window">
        <field name="name">Tiến Trình Tạo Video (Render Jobs)</field>
        <field name="res_model">video.generate.job</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Danh sách các Job tạo Video chạy ngầm (Background Workers).
            </p>
        </field>
    </record>
</odoo>
