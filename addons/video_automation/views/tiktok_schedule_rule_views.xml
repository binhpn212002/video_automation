<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tiktok_schedule_rule_time_tree" model="ir.ui.view">
        <field name="name">tiktok.schedule.rule.time.tree</field>
        <field name="model">tiktok.schedule.rule.time</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="hour"/>
                <field name="minute"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_tiktok_schedule_rule_tree" model="ir.ui.view">
        <field name="name">tiktok.schedule.rule.tree</field>
        <field name="model">tiktok.schedule.rule</field>
        <field name="arch" type="xml">
            <tree decoration-danger="pool_status == 'critical'"
                  decoration-warning="pool_status == 'warning'">
                <field name="name"/>
                <field name="tiktok_account_id"/>
                <field name="slots_per_day"/>
                <field name="pool_available_count"/>
                <field name="pool_needed"/>
                <field name="pool_status"/>
                <field name="allow_republish"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_tiktok_schedule_rule_form" model="ir.ui.view">
        <field name="name">tiktok.schedule.rule.form</field>
        <field name="model">tiktok.schedule.rule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_top_up_pool" type="object" string="Gen bù pool"
                            class="btn-primary"
                            help="Generate video mới từ raw cho đến ngưỡng buffer"/>
                    <field name="pool_status" widget="statusbar"
                            statusbar_visible="ok,warning,critical"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert"
                         invisible="pool_status != 'critical'">
                        Pool thiếu cho ngày mai: còn <field name="pool_available_count"/> video
                        chưa đăng, cần <field name="slots_per_day"/> slot/ngày.
                        Upload raw hoặc bấm <b>Gen bù pool</b>.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="pool_status != 'warning'">
                        Pool sắp thiếu buffer: còn <field name="pool_available_count"/> /
                        cần <field name="pool_needed"/> (slots × buffer ngày).
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tiktok_account_id"/>
                            <field name="timezone"/>
                            <field name="allow_republish"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="caption_template"/>
                            <field name="slots_per_day"/>
                            <field name="pool_available_count"/>
                            <field name="pool_needed"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Upload Times">
                            <field name="upload_time_ids">
                                <tree editable="bottom">
                                    <field name="hour"/>
                                    <field name="minute"/>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_tiktok_schedule_rule" model="ir.actions.act_window">
        <field name="name">Schedule Rules</field>
        <field name="res_model">tiktok.schedule.rule</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
