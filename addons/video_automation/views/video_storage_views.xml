<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_video_storage_tree" model="ir.ui.view">
        <field name="name">video.storage.tree</field>
        <field name="model">video.storage</field>
        <field name="arch" type="xml">
            <tree decoration-danger="pool_status == 'critical'"
                  decoration-warning="pool_status == 'warning'">
                <field name="name"/>
                <field name="bucket_name"/>
                <field name="cdn_domain"/>
                <field name="pool_available_count"/>
                <field name="pool_needed"/>
                <field name="pool_status"/>
                <field name="auto_top_up"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_video_storage_form" model="ir.ui.view">
        <field name="name">video.storage.form</field>
        <field name="model">video.storage</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_top_up_pool" type="object" string="Gen bù pool"
                            class="btn-primary"
                            invisible="not auto_top_up"/>
                    <field name="pool_status" widget="statusbar"
                            statusbar_visible="ok,warning,critical"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="account_id"/>
                            <field name="bucket_name"/>
                            <field name="active"/>
                            <field name="buffer_days"/>
                            <field name="auto_top_up"/>
                            <field name="max_gen_per_run"/>
                        </group>
                        <group>
                            <field name="endpoint"
                                    placeholder="https://&lt;account_id&gt;.r2.cloudflarestorage.com"/>
                            <field name="cdn_domain"
                                    placeholder="https://pub-xxxx.r2.dev"/>
                            <field name="access_key_id" password="True"/>
                            <field name="secret_key" password="True"/>
                            <field name="slots_per_day"/>
                            <field name="pool_available_count"/>
                            <field name="pool_needed"/>
                            <field name="pool_raw_count"/>
                            <div class="text-muted" colspan="2">
                                CDN URL = CDN Domain + / + path
                                Video: https://pub-xxxx.r2.dev/video/v_3_....mp4
                                Audio: https://pub-xxxx.r2.dev/audio/a_....mp3
                                Pool cần = slot/ngày (các account dùng bucket này) × buffer ngày.
                            </div>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_video_storage" model="ir.actions.act_window">
        <field name="name">R2 Storage</field>
        <field name="res_model">video.storage</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
